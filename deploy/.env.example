# Runtime environment variables (place on server as /srv/rill/.env with chmod 0600)
FUSION_PASSWORD=change-me
FUSION_CORS_ALLOWED_ORIGINS=https://rill.example.com
# Keep unset when Caddy reaches this container over the compose network.
# FUSION_LISTEN_HOST=
FUSION_PULL_INTERVAL=1800
FUSION_PULL_CONCURRENCY=3
FUSION_LOG_FORMAT=json
TZ=Asia/Shanghai

# Docker Compose interpolation variables
RILL_IMAGE=lightless-fusion:latest
RILL_PROXY_NETWORK=web

# Local operator deployment config (copy to deploy/.env.deploy; gitignored via .env*)
# DEPLOY_SSH_TARGET=root@your-server
# DEPLOY_SSH_KEY=/path/to/id_ed25519
# DEPLOY_KNOWN_HOSTS=/path/to/known_hosts
# DEPLOY_REMOTE_DIR=/srv/rill
# DEPLOY_IMAGE_NAME=lightless-fusion
# DEPLOY_PLATFORM=linux/amd64
